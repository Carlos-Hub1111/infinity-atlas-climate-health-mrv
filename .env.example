# Shared local environment example. Do not store real secrets here.

APP_NAME="InfinityAtlas Climate & Health MRV Toolkit"
APP_ENV=local
API_PORT=8000
FRONTEND_PORT=5173

# Local default used by backend when Docker/Postgres is not available.
DATABASE_URL=sqlite:///./local.db

# Docker/PostGIS option for later local use:
# DATABASE_URL=postgresql+pg8000://infinityatlas:change-me@db:5432/infinityatlas
POSTGRES_DB=infinityatlas
POSTGRES_USER=infinityatlas
POSTGRES_PASSWORD=change-me

AUTO_CREATE_TABLES=false
AUTO_SEED_DEMO_DATA=false
DEMO_DATA_IS_SYNTHETIC=true
CLIMATE_API_TIMEOUT_SECONDS=8
CLIMATE_CACHE_TTL_SECONDS=900
PUBLIC_MAP_DECIMAL_PLACES=3

# Generate this value locally, for example with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real signing key.
JWT_SECRET_KEY="<generate-a-random-secret-locally>"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=infinityatlas-local

# Optional local-only inputs for `python -m app.demo_users`.
# Leave unset to generate passwords that are displayed once in the local console.
# DEMO_ADMIN_PASSWORD="<set-locally>"
# DEMO_MONITOR_PASSWORD="<set-locally>"
# DEMO_VALIDATOR_PASSWORD="<set-locally>"

VITE_API_BASE_URL=http://127.0.0.1:8000
